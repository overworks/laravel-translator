{
    "name": "minhyung/laravel-translator",
    "description": "Unified translation services (DeepL, Google Cloud Translation, ...) for Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "translation",
        "translator",
        "deepl",
        "google-cloud-translation",
        "anthropic",
        "claude",
        "openai",
        "llm"
    ],
    "authors": [
        {
            "name": "Minhyung Park",
            "email": "urlinee@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "deeplcom/deepl-php": "^1.19",
        "google/auth": "^1.52",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "mozex/anthropic-php": "^1.7",
        "openai-php/client": "^0.20.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Minhyung\\LaravelTranslator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Minhyung\\LaravelTranslator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Minhyung\\LaravelTranslator\\TranslatorServiceProvider"
            ],
            "aliases": {
                "Translator": "Minhyung\\LaravelTranslator\\Facades\\Translator"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
